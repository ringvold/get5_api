<%= if @current_user do %>
  <%!-- Logged-in: brief welcome + quick links --%>
  <section class="mb-10">
    <h1 class="text-2xl font-bold text-zinc-900 dark:text-zinc-100">
      Welcome back
    </h1>
    <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">
      Jump back into managing teams, matches, and servers.
    </p>
  </section>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <.link
      navigate={~p"/teams"}
      class="group rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/40 p-6 hover:border-zinc-400 dark:hover:border-zinc-500 hover:shadow-sm transition"
    >
      <div class="flex items-center gap-3 mb-3">
        <div class="flex-none w-9 h-9 rounded-lg bg-gradient-to-br from-orange-400 to-rose-500 text-white flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-5 h-5"
          >
            <path d="M10 9a3 3 0 100-6 3 3 0 000 6zM6 8a2 2 0 11-4 0 2 2 0 014 0zM1.49 15.326a.78.78 0 01-.358-.442 3 3 0 014.308-3.516 6.484 6.484 0 00-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 01-2.07-.655zM16.44 15.98a4.97 4.97 0 002.07-.654.78.78 0 00.357-.442 3 3 0 00-4.308-3.517 6.484 6.484 0 011.907 3.96 3.87 3.87 0 01-.026.654zM18 8a2 2 0 11-4 0 2 2 0 014 0zM5.304 16.19a.844.844 0 01-.277-.71 5 5 0 019.947 0 .843.843 0 01-.277.71A6.975 6.975 0 0110 18a6.974 6.974 0 01-4.696-1.81z" />
          </svg>
        </div>
        <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Teams</h2>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Manage rosters, players, and team visibility.
      </p>
      <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-3 group-hover:text-zinc-700 dark:group-hover:text-zinc-300">
        View teams →
      </p>
    </.link>

    <.link
      navigate={~p"/matches"}
      class="group rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/40 p-6 hover:border-zinc-400 dark:hover:border-zinc-500 hover:shadow-sm transition"
    >
      <div class="flex items-center gap-3 mb-3">
        <div class="flex-none w-9 h-9 rounded-lg bg-gradient-to-br from-sky-400 to-indigo-500 text-white flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-5 h-5"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .2.08.39.22.53l3 3a.75.75 0 001.06-1.06L10.75 9.69V5z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
        <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Matches</h2>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Configure series, monitor live games, and review stats.
      </p>
      <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-3 group-hover:text-zinc-700 dark:group-hover:text-zinc-300">
        View matches →
      </p>
    </.link>

    <.link
      navigate={~p"/game_servers"}
      class="group rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/40 p-6 hover:border-zinc-400 dark:hover:border-zinc-500 hover:shadow-sm transition"
    >
      <div class="flex items-center gap-3 mb-3">
        <div class="flex-none w-9 h-9 rounded-lg bg-gradient-to-br from-emerald-400 to-teal-500 text-white flex items-center justify-center">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-5 h-5"
          >
            <path
              fill-rule="evenodd"
              d="M4.25 2A2.25 2.25 0 002 4.25v2a2.25 2.25 0 002.25 2.25h11.5A2.25 2.25 0 0018 6.25v-2A2.25 2.25 0 0015.75 2H4.25zm0 9.5A2.25 2.25 0 002 13.75v2a2.25 2.25 0 002.25 2.25h11.5A2.25 2.25 0 0018 15.75v-2a2.25 2.25 0 00-2.25-2.25H4.25zM6 5.25a.75.75 0 01.75-.75h.008a.75.75 0 01.75.75v.008a.75.75 0 01-.75.75H6.75a.75.75 0 01-.75-.75V5.25zm.75 8.75a.75.75 0 00-.75.75v.008c0 .414.336.75.75.75h.008a.75.75 0 00.75-.75V14.75a.75.75 0 00-.75-.75H6.75z"
              clip-rule="evenodd"
            />
          </svg>
        </div>
        <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Servers</h2>
      </div>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        Track game servers and check availability over RCON.
      </p>
      <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-3 group-hover:text-zinc-700 dark:group-hover:text-zinc-300">
        View servers →
      </p>
    </.link>
  </div>
<% else %>
  <%!-- Logged-out: marketing/landing --%>
  <section class="text-center py-16 md:py-24">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-orange-400 to-rose-500 text-white font-bold text-2xl shadow-lg mb-6">
      G5
    </div>

    <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      Get5 webpanel
    </h1>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto">
      Counter-Strike match management for tournaments, scrims, and pickup games.
      Configure matches, manage servers, and track stats — all from one place.
    </p>

    <div class="mt-8 flex items-center justify-center gap-3">
      <.link navigate={~p"/users/register"}>
        <button class="rounded-lg bg-zinc-900 dark:bg-zinc-100 px-5 py-2.5 text-sm font-semibold text-white dark:text-zinc-900 hover:bg-zinc-700 dark:hover:bg-white shadow-sm">
          Create account
        </button>
      </.link>
      <.link navigate={~p"/users/log_in"}>
        <button class="rounded-lg bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-600 px-5 py-2.5 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-700">
          Sign in
        </button>
      </.link>
    </div>
  </section>

  <section class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto pb-16">
    <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/40 p-6">
      <div class="flex-none w-9 h-9 rounded-lg bg-gradient-to-br from-orange-400 to-rose-500 text-white flex items-center justify-center mb-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-5 h-5"
        >
          <path d="M10 9a3 3 0 100-6 3 3 0 000 6zM6 8a2 2 0 11-4 0 2 2 0 014 0zM1.49 15.326a.78.78 0 01-.358-.442 3 3 0 014.308-3.516 6.484 6.484 0 00-1.905 3.959c-.023.222-.014.442.025.654a4.97 4.97 0 01-2.07-.655zM16.44 15.98a4.97 4.97 0 002.07-.654.78.78 0 00.357-.442 3 3 0 00-4.308-3.517 6.484 6.484 0 011.907 3.96 3.87 3.87 0 01-.026.654zM18 8a2 2 0 11-4 0 2 2 0 014 0zM5.304 16.19a.844.844 0 01-.277-.71 5 5 0 019.947 0 .843.843 0 01-.277.71A6.975 6.975 0 0110 18a6.974 6.974 0 01-4.696-1.81z" />
        </svg>
      </div>
      <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Team management</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
        Build rosters with Steam IDs, share teams publicly or keep them private.
      </p>
    </div>

    <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/40 p-6">
      <div class="flex-none w-9 h-9 rounded-lg bg-gradient-to-br from-sky-400 to-indigo-500 text-white flex items-center justify-center mb-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-5 h-5"
        >
          <path
            fill-rule="evenodd"
            d="M10 18a8 8 0 100-16 8 8 0 000 16zm.75-13a.75.75 0 00-1.5 0v5c0 .2.08.39.22.53l3 3a.75.75 0 001.06-1.06L10.75 9.69V5z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
      <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Match orchestration</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
        Set up Bo1 to Bo7 series with map vetoes, side selection, and automatic config delivery.
      </p>
    </div>

    <div class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800/40 p-6">
      <div class="flex-none w-9 h-9 rounded-lg bg-gradient-to-br from-emerald-400 to-teal-500 text-white flex items-center justify-center mb-3">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 20 20"
          fill="currentColor"
          class="w-5 h-5"
        >
          <path
            fill-rule="evenodd"
            d="M4.25 2A2.25 2.25 0 002 4.25v2a2.25 2.25 0 002.25 2.25h11.5A2.25 2.25 0 0018 6.25v-2A2.25 2.25 0 0015.75 2H4.25zm0 9.5A2.25 2.25 0 002 13.75v2a2.25 2.25 0 002.25 2.25h11.5A2.25 2.25 0 0018 15.75v-2a2.25 2.25 0 00-2.25-2.25H4.25zM6 5.25a.75.75 0 01.75-.75h.008a.75.75 0 01.75.75v.008a.75.75 0 01-.75.75H6.75a.75.75 0 01-.75-.75V5.25zm.75 8.75a.75.75 0 00-.75.75v.008c0 .414.336.75.75.75h.008a.75.75 0 00.75-.75V14.75a.75.75 0 00-.75-.75H6.75z"
            clip-rule="evenodd"
          />
        </svg>
      </div>
      <h2 class="font-semibold text-zinc-900 dark:text-zinc-100">Server integration</h2>
      <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1">
        Connect your CS2 servers via RCON. Push match configs, start/end matches, and watch live status.
      </p>
    </div>
  </section>
<% end %>
