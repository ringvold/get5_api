<header class="border-b border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-900">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14">
      <div class="flex items-center gap-8">
        <.link navigate={~p"/"} class="flex items-center gap-2 group">
          <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-gradient-to-br from-orange-400 to-rose-500 text-white font-bold text-xs">
            G5
          </span>
          <span class="font-semibold text-zinc-900 dark:text-zinc-100 group-hover:text-zinc-600 dark:group-hover:text-white">
            Get5
          </span>
        </.link>

        <nav class="flex items-center gap-1">
          <.nav_link
            navigate={~p"/teams"}
            active={active_section(assigns[:current_path]) == :teams}
          >
            Teams
          </.nav_link>
          <.nav_link
            navigate={~p"/matches"}
            active={active_section(assigns[:current_path]) == :matches}
          >
            Matches
          </.nav_link>
          <.nav_link
            navigate={~p"/game_servers"}
            active={active_section(assigns[:current_path]) == :servers}
          >
            Servers
          </.nav_link>
        </nav>
      </div>

      <.user_menu current_user={@current_user} />
    </div>
  </div>
</header>

<main class="px-4 py-8 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
