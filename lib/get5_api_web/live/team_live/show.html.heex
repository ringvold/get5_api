<nav class="text-xs text-zinc-500 dark:text-zinc-400 mb-4">
  <.link navigate={~p"/teams"} class="hover:text-zinc-900 dark:hover:text-zinc-100">
    Teams
  </.link>
  <span class="mx-1.5">/</span>
  <span class="text-zinc-900 dark:text-zinc-100">{@team.name}</span>
</nav>

<section class="rounded-xl border border-zinc-200 dark:border-zinc-700 bg-gradient-to-br from-white to-zinc-50 dark:from-zinc-800/60 dark:to-zinc-900 p-6 mb-6">
  <div class="flex items-start gap-5">
    <div class="flex-none w-16 h-16 rounded-xl bg-gradient-to-br from-orange-400 to-rose-500 flex items-center justify-center text-white font-bold text-xl shadow-md">
      {@team.name |> String.slice(0, 2) |> String.upcase()}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-3 flex-wrap">
        <h1 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-zinc-100 truncate">
          {@team.name}
        </h1>
        <span class={[
          "inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium",
          if(@team.public,
            do: "bg-emerald-50 text-emerald-700 dark:bg-emerald-400/10 dark:text-emerald-300",
            else: "bg-zinc-100 text-zinc-600 dark:bg-zinc-700/60 dark:text-zinc-300"
          )
        ]}>
          <span class={[
            "w-1.5 h-1.5 rounded-full",
            if(@team.public, do: "bg-emerald-500", else: "bg-zinc-400")
          ]}>
          </span>
          {if @team.public, do: "Public", else: "Private"}
        </span>
      </div>

      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400">
        <span :if={@current_user.id == @team.user_id} class="inline-flex items-center gap-1.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4"
          >
            <path d="M10 8a3 3 0 100-6 3 3 0 000 6zM3.465 14.493a1.23 1.23 0 00.41 1.412A9.957 9.957 0 0010 18c2.31 0 4.438-.784 6.131-2.1.43-.333.604-.903.408-1.41a7.002 7.002 0 00-13.074.003z" />
          </svg>
          Owner: You
        </span>
        <span>
          {length(@team.players)} {if length(@team.players) == 1, do: "player", else: "players"}
        </span>
      </div>
    </div>

    <div :if={@current_user.id == @team.user_id} class="flex-none flex gap-2">
      <.link patch={~p"/teams/#{@team}/players/new"} phx-click={JS.push_focus()}>
        <.button>Add player</.button>
      </.link>
      <.link patch={~p"/teams/#{@team}/show/edit"} phx-click={JS.push_focus()}>
        <button class="rounded-lg bg-white dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-600 px-3 py-2 text-sm font-semibold text-zinc-700 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-700">
          Edit team
        </button>
      </.link>
    </div>
  </div>
</section>

<h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400 mb-3">
  Roster
</h2>

<div
  :if={@team.players == []}
  class="rounded-lg border-2 border-dashed border-zinc-300 dark:border-zinc-700 p-8 text-center"
>
  <p class="text-sm text-zinc-500 dark:text-zinc-400">
    No players on this team yet.
  </p>
  <.link
    :if={@current_user.id == @team.user_id}
    patch={~p"/teams/#{@team}/players/new"}
    class="mt-3 inline-block"
  >
    <.button>Add your first player</.button>
  </.link>
</div>

<ul
  :if={@team.players != []}
  id="players"
  class="divide-y divide-zinc-200 dark:divide-zinc-700 rounded-lg border border-zinc-200 dark:border-zinc-700 overflow-hidden bg-white dark:bg-zinc-800/40"
>
  <li
    :for={{player, idx} <- Enum.with_index(@team.players)}
    id={"player-#{player.id}"}
    class="group flex items-center gap-4 px-4 py-3 hover:bg-zinc-50 dark:hover:bg-zinc-700/30 transition"
  >
    <div class="flex-none w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-700 flex items-center justify-center text-xs font-semibold text-zinc-600 dark:text-zinc-300 tabular-nums">
      {idx + 1}
    </div>
    <div class="flex-1 min-w-0">
      <div class="font-semibold text-zinc-900 dark:text-zinc-100 truncate">
        {player.name || "Unnamed player"}
      </div>
      <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 truncate mt-0.5">
        {player.steam_id}
      </div>
    </div>
    <div
      :if={@current_user.id == @team.user_id}
      class="flex-none flex gap-3 text-xs opacity-0 group-hover:opacity-100 transition"
    >
      <.link
        patch={~p"/teams/#{@team}/players/edit/#{player.id}"}
        phx-click={JS.push_focus()}
        class="text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100"
      >
        Edit
      </.link>
      <.link
        phx-click={JS.push("delete_player", value: %{id: player.id})}
        data-confirm="Are you sure?"
        class="text-zinc-500 hover:text-rose-600"
      >
        Delete
      </.link>
    </div>
  </li>
</ul>

<.modal :if={@live_action == :edit} id="team-modal" show on_cancel={JS.patch(~p"/teams/#{@team}")}>
  <.live_component
    module={Get5ApiWeb.TeamLive.FormComponent}
    id={@team.id}
    title={@page_title}
    action={@live_action}
    team={@team}
    current_user={@current_user}
    navigate={~p"/teams/#{@team}"}
  />
</.modal>

<.modal
  :if={@live_action in [:add_player, :edit_player]}
  id="team-player-modal"
  show
  on_cancel={JS.patch(~p"/teams/#{@team}")}
>
  <.live_component
    module={Get5ApiWeb.TeamLive.PlayerFormComponent}
    id="player_modal"
    title={@page_title}
    action={@live_action}
    team={@team}
    player={@player || %Player{}}
    current_user={@current_user}
    navigate={~p"/teams/#{@team}"}
  />
</.modal>
